{
  "name": "allertgy-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "CI=false expo start --go --lan",
    "start:tunnel": "CI=false expo start --go --tunnel",
    "start:dev": "npm_config_cache=.npm_cache CI=false expo start --dev-client --lan",
    "start:dev:tunnel": "npm_config_cache=.npm_cache CI=false expo start --dev-client --tunnel",
    "build:dev:ios": "npm_config_cache=.npm_cache eas build --profile development --platform ios",
    "build:dev:android": "npm_config_cache=.npm_cache eas build --profile development --platform android",
    "build:web": "expo export -p web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --experimental-strip-types src/engine/semaforo.test.ts && node --experimental-strip-types src/engine/allergyLinks.test.ts && node --experimental-strip-types src/engine/semaforoTokens.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-gl": "~16.0.10",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.25.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "@types/three": "^0.185.1",
    "eas-cli": "^20.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3"
