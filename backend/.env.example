# AllerTgy backend — copia in .env e compila. NON committare .env
# Setup guidato: ../SETUP_SERVIZI.md  |  Genera .env: bash scripts/init-env.sh
APP_ENV=development

# ── 1. Hostinger MySQL ← COMPILA ──────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Generato da init-env.sh (openssl rand -hex 64)
JWT_SECRET=
JWT_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8085,exp://localhost:8081
INTERNAL_ADMIN_KEY=

# URL pubblici (link email log, redirect Stripe test)
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# ── 2. Google Gemini ← COMPILA (https://aistudio.google.com/apikey) ─────────
GEMINI_API_KEY=

# ── 3. Cloudflare R2 ← COMPILA (opzionale: vuoto = storage locale) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=allertgy-private

# ── 4. Stripe Test Mode ← COMPILA (https://dashboard.stripe.com, sk_test_...) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO_NOTIFY=
STRIPE_PRICE_BOOST=
STRIPE_PRICE_CUSTOMER_PLUS=

# ── 5. Titolare privacy (go-live) ───────────────────────────────────────────
# LEGAL_ENTITY_NAME=
# LEGAL_PRIVACY_EMAIL=privacy@allertgy.it

# ── Saltati (non servono) ───────────────────────────────────────────────────
# RESEND_API_KEY=        → email nel log console
# SENTRY_DSN=            → non usato
