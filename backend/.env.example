# AllerTgy backend — copia in .env e compila. NON committare .env
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Genera con: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
INTERNAL_ADMIN_KEY=cambia-questa-chiave

# AI Vision (menù + documenti medici) — https://ai.google.dev
GEMINI_API_KEY=

# URL pubblici (link nelle email, redirect Stripe)
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Storage privato — Cloudflare R2 (S3-compatible). Se vuoto: fallback locale in backend/private_storage/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=allertgy-private

# Email transazionali — Resend (https://resend.com). Se vuoto: le email vengono stampate nel log
RESEND_API_KEY=
EMAIL_FROM=AllerTgy <noreply@allertgy.it>

# Stripe Billing — se vuoto gli endpoint /billing rispondono 503
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VERIFIED=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
